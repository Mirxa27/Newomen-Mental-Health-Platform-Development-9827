# Frontend Environment Variables
# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Admin User Configuration
VITE_ADMIN_EMAIL=admin@example.com

# API Base URL (optional, defaults to http://localhost:4000/api)
VITE_API_BASE=http://localhost:4000/api

# Backend Environment Variables
# Server Port
PORT=4000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/newomen_db

# JWT Secret for Authentication
JWT_SECRET=your_secure_jwt_secret_here

# Admin Email (for backend role assignment)
ADMIN_EMAIL=admin@example.com

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Node Environment
NODE_ENV=development

# Voice Provider API Configuration
# OpenAI Realtime API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime

# Deepgram API
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_API_URL=https://api.deepgram.com

# Hume API
HUME_API_KEY=your_hume_api_key_here
HUME_API_URL=https://api.hume.ai

# ElevenLabs API
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1

# Google Speech API
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here
GOOGLE_SPEECH_PROJECT_ID=your_google_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-credentials.json

# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region
AZURE_SPEECH_ENDPOINT=https://your-region.tts.speech.microsoft.com

# Encryption and Security
ENCRYPTION_KEY=your_32_character_encryption_key_here
VOICE_SESSION_SECRET=your_voice_session_secret_here

# Audio Configuration
AUDIO_STORAGE_PATH=./uploads/audio
AUDIO_MAX_FILE_SIZE=50000000
AUDIO_ALLOWED_FORMATS=mp3,wav,ogg,webm
AUDIO_SAMPLE_RATE=24000

# WebSocket Configuration
WEBSOCKET_PORT=4001
WEBSOCKET_SSL=false
WEBSOCKET_HEARTBEAT_INTERVAL=30000

# Rate Limiting
VOICE_RATE_LIMIT_WINDOW=60000
VOICE_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW=60000
API_RATE_LIMIT_MAX=100

# Session Management
VOICE_SESSION_TIMEOUT=300000
VOICE_SESSION_CLEANUP_INTERVAL=60000