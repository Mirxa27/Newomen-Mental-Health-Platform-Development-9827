// Prisma schema for Newomen Mental Health Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum for user roles
enum Role {
  user
  admin
  counsellor // for crisis protocol
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  name                String
  password            String                // hashed
  role                Role                  @default(user)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  conversations       Conversation[]
  shadowWorkSessions  ShadowWorkSession[]
  voiceProfiles       VoiceProfile[]
  voiceSessions       VoiceSession[]
  subscription        Subscription?
  payments            Payment[]
  notifications       Notification[]
  crisisAlerts        CrisisAlert[]
  analytics           UserAnalytics?
  fileUploads         FileUpload[]
  moodEntries         MoodEntry[]
  activeSessions      ActiveSession[]
}

model Conversation {
  id            String         @id @default(uuid())
  title         String
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]
  voiceSessions VoiceSession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  content        String
  role           String       // 'user' or 'assistant'
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  timestamp      DateTime     @default(now())
  crisisAlerts   CrisisAlert[]
}

model ShadowWorkSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  response   String
  insights   String?
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([userId, questionId])
}

enum ProviderType {
  CHAT
  SPEECH_TO_TEXT
  TEXT_TO_SPEECH
  REALTIME_VOICE
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model AIProvider {
  id          String         @id @default(uuid())
  name        String         @unique
  type        ProviderType
  status      ProviderStatus @default(INACTIVE)
  apiKey      String?        // Encrypted
  apiUrl      String?
  model       String?
  voice       String?
  settings    Json?          // Additional provider-specific settings
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  // Usage tracking
  usageCount  Int            @default(0)
  lastUsed    DateTime?
  
  // Relations
  voiceProfiles VoiceProfile[]
  voiceSessions VoiceSession[]
  
  @@index([type, status])
}

model VoiceProfile {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  voiceId     String     // Provider-specific voice ID
  providerId  String
  provider    AIProvider @relation(fields: [providerId], references: [id])
  settings    Json?      // Voice-specific settings (speed, pitch, etc.)
  isDefault   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@unique([userId, name])
}

model VoiceSession {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  providerId      String
  provider        AIProvider    @relation(fields: [providerId], references: [id])
  sessionId       String?       // Provider-specific session ID
  status          String        @default("active") // active, ended, error
  duration        Int?          // Duration in seconds
  audioUrl        String?       // Recording URL if saved
  transcript      String?       // Full session transcript
  createdAt       DateTime      @default(now())
  endedAt         DateTime?
}

model SystemSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  category    String   @default("general")
  isPublic    Boolean  @default(false) // Whether frontend can access this setting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Payment and Subscription Models
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  EXPIRED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId  String?            @unique
  stripeSubscriptionId String?         @unique
  status            SubscriptionStatus @default(TRIALING)
  planId            String
  plan              SubscriptionPlan   @relation(fields: [planId], references: [id])
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payments          Payment[]
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  price         Float          // Monthly price in cents
  currency      String         @default("usd")
  stripePriceId String?        @unique
  features      Json           // List of features included
  maxMessages   Int?           // Message limit per month
  maxVoiceTime  Int?           // Voice chat time limit in minutes
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Payment {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
  stripePaymentId  String?       @unique
  amount           Float         // Amount in cents
  currency         String        @default("usd")
  status           PaymentStatus @default(PENDING)
  description      String?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// Notification Models
enum NotificationType {
  SYSTEM
  REMINDER
  ACHIEVEMENT
  CRISIS_ALERT
  PAYMENT
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType @default(SYSTEM)
  title       String
  message     String
  isRead      Boolean          @default(false)
  actionUrl   String?
  metadata    Json?            // Additional notification data
  createdAt   DateTime         @default(now())
  readAt      DateTime?
  
  @@index([userId, isRead])
}

// Crisis Support Models
enum CrisisStatus {
  ACTIVE
  RESOLVED
  ESCALATED
  CLOSED
}

model CrisisAlert {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId   String?     // If triggered by a specific message
  message     Message?    @relation(fields: [messageId], references: [id])
  severity    Int         @default(5) // 1-10 scale
  status      CrisisStatus @default(ACTIVE)
  keywords    String[]    // Keywords that triggered the alert
  response    String?     // Counselor response
  respondedBy String?     // Counselor ID who responded
  createdAt   DateTime    @default(now())
  resolvedAt  DateTime?
  
  @@index([status, severity])
}

// Analytics and Usage Models
model UserAnalytics {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalMessages         Int      @default(0)
  totalVoiceMinutes     Int      @default(0)
  shadowWorkSessions    Int      @default(0)
  lastActiveAt          DateTime @default(now())
  streakDays            Int      @default(0)
  longestStreak         Int      @default(0)
  totalSessionTime      Int      @default(0) // In minutes
  moodScores            Json?    // Historical mood tracking
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// File Upload Models
enum FileType {
  AVATAR
  DOCUMENT
  AUDIO
  IMAGE
  BACKUP
}

model FileUpload {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  originalName String
  mimetype  String
  size      Int      // File size in bytes
  type      FileType
  url       String   // Storage URL
  metadata  Json?    // Additional file metadata
  createdAt DateTime @default(now())
  
  @@index([userId, type])
}

// Mood Tracking Models
model MoodEntry {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int      // 1-10 mood scale
  notes       String?
  tags        String[] // Mood tags like "anxious", "happy", etc.
  createdAt   DateTime @default(now())
  
  @@index([userId, createdAt])
}

// Session Management for Real-time Features
model ActiveSession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  socketId        String   @unique
  userAgent       String?
  ipAddress       String?
  isActive        Boolean  @default(true)
  lastActivity    DateTime @default(now())
  createdAt       DateTime @default(now())
  
  @@index([userId, isActive])
}